{
	"name": "kiri-focus-timer",
	"version": "0.3.3",
	"description": "Focus timer for Obsidian with tasks, breaks, local noise and a daily-note log.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"lint": "eslint .",
		"dev-vault": "npm run build && node scripts/copy-to-test-vault.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian-plugin",
		"focus",
		"timer",
		"pomodoro"
	],
	"author": "Kiri",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.5",
		"esbuild": "^0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"moment": "^2.31.0",
		"obsidian": "^1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.2",
		"vitest": "^3.2.7"
	}
}
